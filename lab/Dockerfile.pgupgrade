# syntax=docker/dockerfile:1.7
# Dual-major Postgres lab image for `pgmig upgrade lab`.
#
# pg_upgrade needs the OLD and NEW major's binaries on one host; no official
# postgres image ships two majors, so we install both from the PGDG apt repo.
# Everything (initdb / pg_ctl / pg_upgrade / vacuumdb) is driven from the host
# via `docker exec <lab> su postgres -c ...` by src/upgrade/lab.ts - the
# container only needs to stay alive.
ARG FROM_MAJOR=15
ARG TO_MAJOR=17
FROM debian:bookworm-slim
ARG FROM_MAJOR
ARG TO_MAJOR
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates gnupg rsync \
 && install -d /usr/share/postgresql-common/pgdg \
 && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
      -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
 && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      postgresql-${FROM_MAJOR} \
      postgresql-${TO_MAJOR} \
 && mkdir -p /pgdata \
 && chown -R postgres:postgres /pgdata
CMD ["sleep", "infinity"]
